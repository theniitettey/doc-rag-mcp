# Copy this file to .env and fill in values as needed.
# docker-compose.yaml reads .env automatically; for local (non-Docker) runs,
# `make ingest`/`make serve`/etc. do `set -a; source .env; set +a` for you.
# Because that's a real shell source, not a dotenv parser: quote any value
# containing a space (e.g. RAG_DOCS_DIR="/path/with spaces/file.pdf") or it
# gets word-split and silently truncated.

# --- Paths / indexing (used by ingest.py) ---
# Folder containing your docs (.pdf, .md, .txt), or a path to one file
# directly to index just that file instead of a whole folder.
RAG_DOCS_DIR=./docs

# Collection name (must match between ingest.py and server.py) -- namespaces
# rows within the shared Postgres table, so multiple doc sets can coexist.
RAG_COLLECTION=project_docs

# Chunking (characters per chunk / overlap between chunks)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# Which embedding provider to use: voyage (default) | azure-openai | openai.
# Whichever you pick, ingest.py and server.py must agree (same .env), or
# query embeddings won't match the index.
RAG_EMBED_PROVIDER=voyage

# Embedding model. Meaning depends on RAG_EMBED_PROVIDER:
#   voyage        a Voyage model name, e.g. voyage-4-large (used below).
#   azure-openai  ignored -- AZURE_OPENAI_EMBED_DEPLOYMENT is what's actually
#                 sent as the model, since Azure routes by deployment name.
#   openai        an OpenAI embedding model name, e.g. text-embedding-3-large.
RAG_EMBED_MODEL=voyage-4-large

# Output dimension of RAG_EMBED_MODEL -- must match, since it's baked into
# the Postgres vector column. Defaults: voyage-4-large=1024 (also supports
# 256/512/2048), voyage-4-lite=1024 (same flexible options); OpenAI's
# text-embedding-3-* models also support arbitrary smaller dimensions via
# this same setting (older ada-002 does not -- leave it at ada-002's native
# 1536 if you use that model). Changing this after data has been ingested
# requires wiping the table (make db-reset) and re-ingesting.
RAG_EMBED_DIM=1024

# --- Azure OpenAI (only used when RAG_EMBED_PROVIDER=azure-openai) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=

# --- OpenAI, or any OpenAI-compatible endpoint (RAG_EMBED_PROVIDER=openai) ---
# OPENAI_BASE_URL blank = api.openai.com; set it to point at a compatible
# self-hosted endpoint instead (Ollama, vLLM, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: re-score query_docs's candidates with Voyage's rerank API
# (e.g. rerank-2.5) for more accurate results than cosine similarity alone --
# it scores the actual query/document pair instead of comparing two
# independently computed vectors. Always uses Voyage regardless of
# RAG_EMBED_PROVIDER above (no Azure/OpenAI equivalent exists) -- costs its
# own tokens on every query (a rerank call processes full chunk text, so
# it's typically far more tokens than the query embedding itself) -- leave
# blank to disable (default).
#
# If RAG_EMBED_PROVIDER above isn't voyage, setting this requires
# RAG_ALLOW_CROSS_PROVIDER_RERANK=true too (see below) -- otherwise it's
# refused, since it would send chunk text to Voyage despite you having
# picked a different provider, possibly for data-residency reasons.
RAG_RERANK_MODEL=

# Required only if RAG_RERANK_MODEL is set AND RAG_EMBED_PROVIDER isn't
# voyage: explicit acknowledgment that chunk text will go to Voyage for
# reranking even though a different provider embeds your documents. Not
# needed when RAG_EMBED_PROVIDER=voyage -- that's not a cross-provider
# egress, it's the same provider for both.
RAG_ALLOW_CROSS_PROVIDER_RERANK=

# Optional, free alternative/complement to reranking: fuse vector search
# with Postgres full-text search (no API calls at all -- works the same
# regardless of RAG_EMBED_PROVIDER). Helps most on queries with specific
# terms/codes/names that cosine similarity alone can under-rank. Only takes
# effect when RAG_RERANK_MODEL above is unset (rerank wins if both are set).
# true/1/yes to enable; anything else (default) disables it.
RAG_HYBRID_SEARCH=

# Voyage AI API key -- required if RAG_EMBED_PROVIDER=voyage and/or
# RAG_RERANK_MODEL is set (get one at https://dash.voyageai.com); not
# needed at all if you use azure-openai/openai for embedding with no rerank.
VOYAGE_API_KEY=

# --- Postgres / pgvector (used by ingest.py and server.py) ---
# Also read directly by the `db` service in docker-compose.yaml.
POSTGRES_USER=raguser
POSTGRES_PASSWORD=
POSTGRES_DB=ragdb

# Full connection string. Docker Compose builds its own copy of this
# pointed at the "db" service; this one is for running ingest.py/server.py
# locally (outside Docker) against the same database via `make db`, which
# publishes it on localhost:5433 (not 5432, to avoid clashing with another
# project's Postgres on the same machine).
RAG_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}

# --- Query cache (used by server.py) ---
RAG_CACHE_MAX_SIZE=256
RAG_CACHE_TTL_SECONDS=600

# --- Server transport (used by server.py) ---
# stdio (default, local subprocess) or http (network-reachable)
RAG_TRANSPORT=stdio
RAG_HOST=127.0.0.1
# Deliberately not 8000/5000/3000 -- those are usually already taken by
# something else on a dev machine. Also used by docker-compose.yaml (both
# the container's internal port and the host-side mapping move together).
RAG_PORT=8743

# Required when RAG_TRANSPORT=http (or --transport http). Clients must send
# `Authorization: Bearer <token>`. Generate + write one with: make auth-token
RAG_AUTH_TOKEN=
